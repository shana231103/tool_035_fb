# Application Environment Configuration Template
# Copy this file to .env and fill in your actual values.

# Microsoft Graph Mailbox Integration
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# AntiCaptcha Integration (Optional, for reCAPTCHA resolution)
ANTICAPTCHA_API_KEY=your_anticaptcha_api_key_here
ANTICAPTCHA_TIMEOUT=120.0

# Browser Automation Engine
HEADLESS_BROWSER=true

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./report_fb.db
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000/static
